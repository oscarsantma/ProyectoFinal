<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="#F8F9FA">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:background="@color/verde_andalucia_primary"
        android:padding="20dp" android:gravity="center_vertical">
        <TextView android:id="@+id/btnVolver"
            android:layout_width="40dp" android:layout_height="40dp"
            android:text="&#8592;" android:textSize="22sp" android:textColor="#FFFFFF"
            android:gravity="center" android:layout_marginEnd="10dp"
            android:clickable="true" android:focusable="true"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Perfil del residente" android:textSize="20sp" android:textStyle="bold"
            android:textColor="#FFFFFF"/>
    </LinearLayout>
    <ScrollView android:layout_width="match_parent" android:layout_height="match_parent">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="16dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:gravity="center"
                android:background="@drawable/bg_card" android:padding="24dp"
                android:layout_marginBottom="16dp" android:elevation="2dp">
                <TextView android:layout_width="80dp" android:layout_height="80dp"
                    android:text="&#128116;" android:textSize="52sp" android:gravity="center"
                    android:background="@drawable/bg_icon_box_light" android:textColor="@color/verde_andalucia_primary" android:layout_marginBottom="12dp"/>
                <TextView android:id="@+id/tvNombrePerfilResidente" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Antonio Garc&#237;a L&#243;pez" android:textSize="20sp"
                    android:textStyle="bold" android:textColor="#212529"/>
                <TextView android:id="@+id/tvResumenPerfilResidente" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="82 a&#241;os &#183; Hab. 100 &#183; Planta 2"
                    android:textSize="13sp" android:textColor="#6C757D" android:layout_marginTop="4dp"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="&#9679; Residente activo" android:textSize="11sp"
                    android:textColor="#27AE60" android:layout_marginTop="6dp"/>
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:background="@drawable/bg_card"
                android:padding="20dp" android:layout_marginBottom="16dp" android:elevation="2dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="INFORMACI&#211;N PERSONAL" android:textSize="10sp"
                    android:textStyle="bold" android:textColor="@color/verde_andalucia_primary"
                    android:layout_marginBottom="12dp"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Fecha de nacimiento" android:textSize="10sp" android:textColor="#6C757D"/>
                <TextView android:id="@+id/tvFechaNacimientoPerfil" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="15 de marzo de 1943" android:textSize="14sp"
                    android:textColor="#212529" android:layout_marginBottom="12dp"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Fecha de ingreso" android:textSize="10sp" android:textColor="#6C757D"/>
                <TextView android:id="@+id/tvFechaIngresoPerfil" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="10 de enero de 2023" android:textSize="14sp"
                    android:textColor="#212529" android:layout_marginBottom="12dp"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Habitaci&#243;n" android:textSize="10sp" android:textColor="#6C757D"/>
                <TextView android:id="@+id/tvHabitacionPerfil" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="100 &#183; Planta 2" android:textSize="14sp" android:textColor="#212529"/>
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:background="@drawable/bg_card"
                android:padding="20dp" android:elevation="2dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="OBSERVACIONES" android:textSize="10sp"
                    android:textStyle="bold" android:textColor="@color/verde_andalucia_primary"
                    android:layout_marginBottom="12dp"/>
                <TextView android:id="@+id/tvObservacionesPerfil" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Dieta blanda. Toma medicaci&#243;n para la tensi&#243;n y el est&#243;mago por la ma&#241;ana. Le gusta escuchar m&#250;sica cl&#225;sica. Las visitas por la ma&#241;ana son preferibles."
                    android:textSize="13sp" android:textColor="#212529" android:lineSpacingExtra="4dp"/>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
