<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/gris_fondo">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@color/verde_andalucia_primary"
        android:padding="20dp"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tvTituloSolicitudes"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Solicitudes pendientes"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/tvTituloRegistros"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="REGISTROS PENDIENTES"
                android:textStyle="bold"
                android:textSize="10sp"
                android:textColor="@color/gris_texto"
                android:layout_marginBottom="10dp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvRegistrosPendientes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false" />

            <TextView
                android:id="@+id/tvSinRegistros"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="No hay registros pendientes."
                android:textColor="@color/gris_texto"
                android:textSize="14sp"
                android:gravity="center"
                android:paddingVertical="18dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvTituloVisitas"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="VISITAS PENDIENTES"
                android:textStyle="bold"
                android:textSize="10sp"
                android:textColor="@color/gris_texto"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="10dp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvSolicitudes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false" />

            <TextView
                android:id="@+id/tvSinSolicitudes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="No hay solicitudes pendientes"
                android:textSize="15sp"
                android:textColor="@color/gris_texto"
                android:gravity="center"
                android:paddingVertical="18dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/btnVolver"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:text="Volver"
                android:textSize="14sp"
                android:textColor="@color/gris_texto"
                android:gravity="center"
                android:textStyle="bold"
                android:background="@drawable/bg_card"
                android:clickable="true"
                android:focusable="true"
                android:layout_marginTop="12dp" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
