<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_card"
    android:padding="16dp"
    android:layout_marginBottom="10dp"
    android:elevation="2dp">

    <TextView
        android:id="@+id/tvNombreResidenteItem"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Antonio Garcia Lopez"
        android:textSize="15sp"
        android:textStyle="bold"
        android:textColor="@color/negro_suave" />

    <TextView
        android:id="@+id/tvHabitacionResidenteItem"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Hab. 100 · Planta 2"
        android:textSize="12sp"
        android:textColor="@color/verde_andalucia_primary"
        android:layout_marginTop="6dp" />

    <TextView
        android:id="@+id/tvNecesidadesResidenteItem"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Necesidades del residente"
        android:textSize="12sp"
        android:textColor="@color/gris_texto"
        android:layout_marginTop="8dp" />

    <TextView
        android:id="@+id/tvEstadoResidenteItem"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Activo"
        android:textSize="11sp"
        android:textStyle="bold"
        android:textColor="@color/verde_andalucia_primary"
        android:layout_marginTop="10dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="12dp">

        <TextView
            android:id="@+id/btnEditarResidente"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:text="Editar"
            android:textStyle="bold"
            android:textColor="@color/blanco"
            android:gravity="center"
            android:background="@drawable/bg_boton_verde"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/btnBajaResidente"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:text="Dar de baja"
            android:textStyle="bold"
            android:textColor="@color/blanco"
            android:gravity="center"
            android:background="@drawable/bg_boton_rojo"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>
</LinearLayout>
