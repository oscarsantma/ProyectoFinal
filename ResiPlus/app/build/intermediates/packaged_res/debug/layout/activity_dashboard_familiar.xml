<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/gris_fondo">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/verde_andalucia_primary"
        android:padding="20dp">

        <TextView
            android:id="@+id/tvSaludo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Hola"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/blanco" />

        <TextView
            android:id="@+id/tvEstadoCuentaFamiliar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Cuenta activa"
            android:textSize="13sp"
            android:textColor="#D8FFFFFF"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="14dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#33FFFFFF"
            android:padding="16dp">

            <TextView
                android:id="@+id/tvNombreResidenteDashboard"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Residente"
                android:textSize="17sp"
                android:textStyle="bold"
                android:textColor="@color/blanco" />

            <TextView
                android:id="@+id/tvResumenResidenteDashboard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Resumen"
                android:textSize="12sp"
                android:textColor="#D8FFFFFF"
                android:layout_marginTop="6dp" />
        </LinearLayout>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="88dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/bg_card">

                    <TextView
                        android:id="@+id/tvPendientesFamilia"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textSize="28sp"
                        android:textStyle="bold"
                        android:textColor="@color/verde_andalucia_primary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Pendientes"
                        android:textSize="11sp"
                        android:textColor="@color/gris_texto" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="88dp"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/bg_card">

                    <TextView
                        android:id="@+id/tvConfirmadasFamilia"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textSize="28sp"
                        android:textStyle="bold"
                        android:textColor="@color/verde_andalucia_primary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Confirmadas"
                        android:textSize="11sp"
                        android:textColor="@color/gris_texto" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/cardSolicitarVisita"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:padding="18dp"
                android:layout_marginBottom="10dp"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Solicitar una cita"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:textColor="@color/verde_andalucia_primary" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Elige fecha, franja disponible y deja una nota para el equipo."
                    android:textSize="12sp"
                    android:textColor="@color/gris_texto"
                    android:layout_marginTop="6dp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/cardMisVisitas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:padding="18dp"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Estado de mis citas"
                        android:textSize="17sp"
                        android:textStyle="bold"
                        android:textColor="@color/verde_andalucia_primary" />

                    <TextView
                        android:id="@+id/tvBadgeVisitas"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="1"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="@color/blanco"
                        android:background="@drawable/bg_boton_verde"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="3dp"
                        android:visibility="gone" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Consulta las citas aceptadas, pendientes o rechazadas."
                    android:textSize="12sp"
                    android:textColor="@color/gris_texto"
                    android:layout_marginTop="6dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#E8F5E9"
                android:padding="16dp"
                android:layout_marginTop="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="PRÓXIMA VISITA"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:textColor="@color/verde_andalucia_primary" />

                <TextView
                    android:id="@+id/tvProximaVisita"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Sin visitas confirmadas"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:textColor="@color/negro_suave"
                    android:layout_marginTop="6dp" />

                <TextView
                    android:id="@+id/tvDetalleProximaVisita"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Puedes enviar una nueva solicitud."
                    android:textSize="12sp"
                    android:textColor="@color/gris_texto"
                    android:layout_marginTop="6dp" />
            </LinearLayout>

            <TextView
                android:id="@+id/btnVolverMenuPrincipalFamiliar"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:text="Volver al acceso"
                android:textSize="13sp"
                android:textColor="@color/gris_texto"
                android:gravity="center"
                android:textStyle="bold"
                android:background="@drawable/bg_card"
                android:clickable="true"
                android:focusable="true"
                android:layout_marginTop="12dp" />

            <TextView
                android:id="@+id/tvCerrarSesion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Cerrar sesión"
                android:textSize="13sp"
                android:textColor="@color/gris_texto"
                android:gravity="center"
                android:padding="14dp"
                android:layout_marginTop="12dp"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
