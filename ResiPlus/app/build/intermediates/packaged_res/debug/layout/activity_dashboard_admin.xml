<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/gris_fondo">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/verde_andalucia_primary"
        android:padding="20dp">

        <TextView
            android:id="@+id/tvSaludoAdmin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Panel general"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/blanco" />

        <TextView
            android:id="@+id/tvDetalleAdmin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Administra residencias, residentes y altas del personal."
            android:textSize="13sp"
            android:textColor="#D8FFFFFF"
            android:layout_marginTop="8dp" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="92dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/bg_card">

                    <TextView
                        android:id="@+id/tvTotalResidenciasAdmin"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textSize="28sp"
                        android:textStyle="bold"
                        android:textColor="@color/verde_andalucia_primary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Residencias"
                        android:textSize="11sp"
                        android:textColor="@color/gris_texto" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="92dp"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/bg_card">

                    <TextView
                        android:id="@+id/tvTotalResidentesAdmin"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textSize="28sp"
                        android:textStyle="bold"
                        android:textColor="@color/verde_andalucia_primary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Residentes"
                        android:textSize="11sp"
                        android:textColor="@color/gris_texto" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:padding="18dp"
                android:layout_marginBottom="12dp">

                <TextView
                    android:id="@+id/tvPersonalPendienteAdmin"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textSize="28sp"
                    android:textStyle="bold"
                    android:textColor="@color/verde_andalucia_primary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Empleados pendientes de aprobación"
                    android:textSize="12sp"
                    android:textColor="@color/gris_texto" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/cardGestionarEquipoAdmin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:padding="18dp"
                android:layout_marginBottom="10dp"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Validar altas del personal"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/verde_andalucia_primary" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Revisa las cuentas de trabajadoras y empleados asociadas a cada residencia."
                    android:textSize="12sp"
                    android:textColor="@color/gris_texto"
                    android:layout_marginTop="6dp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/cardGestionarResidenciasAdmin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:padding="18dp"
                android:layout_marginBottom="10dp"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Gestionar residencias y residentes"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/verde_andalucia_primary" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Crea residencias nuevas y entra en cada una para añadir o editar residentes."
                    android:textSize="12sp"
                    android:textColor="@color/gris_texto"
                    android:layout_marginTop="6dp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/cardCrearUsuarioAdmin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:padding="18dp"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Alta manual de usuarios"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/verde_andalucia_primary" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Crea cuentas directamente si una residencia necesita dar acceso inmediato."
                    android:textSize="12sp"
                    android:textColor="@color/gris_texto"
                    android:layout_marginTop="6dp" />
            </LinearLayout>

            <TextView
                android:id="@+id/btnVolverMenuPrincipalAdmin"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:text="Volver al acceso"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/gris_texto"
                android:background="@drawable/bg_card"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:layout_marginTop="10dp" />

            <TextView
                android:id="@+id/tvCerrarSesionAdmin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Cerrar sesión"
                android:textSize="13sp"
                android:textColor="@color/gris_texto"
                android:gravity="center"
                android:padding="16dp"
                android:layout_marginTop="10dp"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
